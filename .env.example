# Amazon アソシエイトタグ。承認後にここを埋める。
# 例: mangal-22
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=

# Amazon ロケール（既定 jp）。.co.jp 以外を使う場合のみ変更。
NEXT_PUBLIC_AMAZON_LOCALE=jp

# 以下はフェーズB（PA-API 承認後）に使用
PAAPI_ACCESS_KEY=
PAAPI_SECRET_KEY=
PAAPI_PARTNER_TAG=

# 楽天ウェブサービス applicationId（UUID 形式。
# https://webservice.rakuten.co.jp/ でアプリ登録すると発行される）
RAKUTEN_APP_ID=

# 楽天ウェブサービス アクセスキー（2026年2月の API 仕様変更で必須化された
# 二重認証キー。アプリ詳細画面の「アクセスキー」欄から取得）
RAKUTEN_ACCESS_KEY=

# 楽天デベロッパーズの「許可されたWebサイト」に登録した URL のいずれか。
# 未設定時は http://localhost/（許可ドメインに localhost が必要）。
# GitHub Actions から呼ぶなら https://github.com/ を登録 → ここに指定。
# Origin ヘッダはこの URL のオリジン部から自動生成される。
RAKUTEN_REFERER=
