# Amazon アソシエイトタグ。承認後にここを埋める。
# 例: mangal-22
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=

# Amazon ロケール（既定 jp）。.co.jp 以外を使う場合のみ変更。
NEXT_PUBLIC_AMAZON_LOCALE=jp

# 以下はフェーズB（PA-API 承認後）に使用
PAAPI_ACCESS_KEY=
PAAPI_SECRET_KEY=
PAAPI_PARTNER_TAG=

# 楽天ウェブサービス アプリID（https://webservice.rakuten.co.jp/ で発行）
# scripts/fetch-rakuten.ts が書誌データの取得に使用。
RAKUTEN_APP_ID=
