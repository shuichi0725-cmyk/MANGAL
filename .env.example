# Amazon アソシエイトタグ。承認後にここを埋める。
# 例: mangal-22
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=

# Amazon ロケール（既定 jp）。.co.jp 以外を使う場合のみ変更。
NEXT_PUBLIC_AMAZON_LOCALE=jp

# 以下はフェーズB（PA-API 承認後）に使用
PAAPI_ACCESS_KEY=
PAAPI_SECRET_KEY=
PAAPI_PARTNER_TAG=

# 楽天ウェブサービス applicationId（UUID 形式。
# https://webservice.rakuten.co.jp/ でアプリ登録すると発行される）
RAKUTEN_APP_ID=

# 楽天ウェブサービス アクセスキー（2026年2月の API 仕様変更で必須化された
# 二重認証キー。アプリ詳細画面の「アクセスキー」欄から取得）
RAKUTEN_ACCESS_KEY=

# 楽天デベロッパーズの「許可されたWebサイト」に登録した URL のいずれか。
# 注: 新仕様の楽天 dev は localhost を許可ドメインとして受け付けないため、
# ローカル実行でも実在ドメイン（github.com / 本番デプロイ先 等）を登録 →
# その値をここに指定する必要がある。
# GitHub Actions から呼ぶ場合: https://github.com/
# Origin ヘッダはこの URL のオリジン部から自動生成。
RAKUTEN_REFERER=

# Google Books API v1 のキー（任意。未設定でも anonymous で動くが
# 1000 req/day の厳しい制限がかかる）。取得は
# https://console.cloud.google.com/apis/credentials → Books API を有効化。
# 用途: scripts/probe-isbn-sources.ts （ISBN 取得 source 比較 probe）
GOOGLE_BOOKS_API_KEY=
